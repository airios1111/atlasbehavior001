{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "ATLAS Behavior Map: AIAgentToolCalls_CL custom table and the data collection rule that ingests normalized 'agent_runtime' events through the Logs Ingestion API."
  },
  "parameters": {
    "workspaceName": {
      "type": "string",
      "metadata": {
        "description": "Log Analytics workspace of Microsoft Sentinel (same resource group)."
      }
    },
    "dataCollectionEndpointName": {
      "type": "string",
      "defaultValue": "abm-ingestion",
      "metadata": {
        "description": "Data collection endpoint shared by all ABM sources; created if missing."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Region of the workspace."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces/tables",
      "apiVersion": "2025-07-01",
      "name": "[format('{0}/{1}', parameters('workspaceName'), 'AIAgentToolCalls_CL')]",
      "properties": {
        "plan": "Analytics",
        "schema": {
          "name": "AIAgentToolCalls_CL",
          "columns": [
            {
              "name": "TimeGenerated",
              "type": "dateTime"
            },
            {
              "name": "ActingAboveUserPrivilege",
              "type": "boolean"
            },
            {
              "name": "ActorIsAdmin",
              "type": "boolean"
            },
            {
              "name": "AgentId",
              "type": "string"
            },
            {
              "name": "AttachmentCount",
              "type": "long"
            },
            {
              "name": "ChangeOrigin",
              "type": "string"
            },
            {
              "name": "ChangeTarget",
              "type": "string"
            },
            {
              "name": "CloudApi",
              "type": "string"
            },
            {
              "name": "ConfigKey",
              "type": "string"
            },
            {
              "name": "ContextHasUntrustedContent",
              "type": "boolean"
            },
            {
              "name": "CostUsd",
              "type": "real"
            },
            {
              "name": "DestinationAllowlisted",
              "type": "boolean"
            },
            {
              "name": "DestinationDomain",
              "type": "string"
            },
            {
              "name": "EventType",
              "type": "string"
            },
            {
              "name": "FilePath",
              "type": "string"
            },
            {
              "name": "HostId",
              "type": "string"
            },
            {
              "name": "HumanApproved",
              "type": "boolean"
            },
            {
              "name": "InitiatedByUser",
              "type": "boolean"
            },
            {
              "name": "InputOrigin",
              "type": "string"
            },
            {
              "name": "InputSpanIds",
              "type": "dynamic"
            },
            {
              "name": "InterArrivalS",
              "type": "real"
            },
            {
              "name": "IsExternalEgress",
              "type": "long"
            },
            {
              "name": "IsSecretRead",
              "type": "long"
            },
            {
              "name": "Operation",
              "type": "string"
            },
            {
              "name": "PageTrust",
              "type": "string"
            },
            {
              "name": "ParentSpanId",
              "type": "string"
            },
            {
              "name": "PrincipalId",
              "type": "string"
            },
            {
              "name": "RecipientExternal",
              "type": "boolean"
            },
            {
              "name": "RecordsReturned",
              "type": "long"
            },
            {
              "name": "RequestBytes",
              "type": "long"
            },
            {
              "name": "SessionId",
              "type": "string"
            },
            {
              "name": "SourceTrust",
              "type": "string"
            },
            {
              "name": "SpanId",
              "type": "string"
            },
            {
              "name": "TargetCategory",
              "type": "string"
            },
            {
              "name": "ToolArgs",
              "type": "string"
            },
            {
              "name": "ToolCategory",
              "type": "string"
            },
            {
              "name": "ToolClass",
              "type": "string"
            },
            {
              "name": "ToolInScope",
              "type": "boolean"
            },
            {
              "name": "ToolName",
              "type": "string"
            },
            {
              "name": "ToolOutput",
              "type": "string"
            },
            {
              "name": "ToolRisk",
              "type": "string"
            },
            {
              "name": "TraceId",
              "type": "string"
            },
            {
              "name": "Url",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Insights/dataCollectionEndpoints",
      "apiVersion": "2023-03-11",
      "name": "[parameters('dataCollectionEndpointName')]",
      "location": "[parameters('location')]",
      "properties": {
        "networkAcls": {
          "publicNetworkAccess": "Enabled"
        }
      }
    },
    {
      "type": "Microsoft.Insights/dataCollectionRules",
      "apiVersion": "2023-03-11",
      "name": "abm-agent-runtime",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces/tables', parameters('workspaceName'), 'AIAgentToolCalls_CL')]",
        "[resourceId('Microsoft.Insights/dataCollectionEndpoints', parameters('dataCollectionEndpointName'))]"
      ],
      "properties": {
        "dataCollectionEndpointId": "[resourceId('Microsoft.Insights/dataCollectionEndpoints', parameters('dataCollectionEndpointName'))]",
        "streamDeclarations": {
          "Custom-AIAgentToolCallsRaw": {
            "columns": [
              {
                "name": "acting_above_user_privilege",
                "type": "boolean"
              },
              {
                "name": "actor_is_admin",
                "type": "boolean"
              },
              {
