                "type": "datetime"
              },
              {
                "name": "tool_args",
                "type": "string"
              },
              {
                "name": "tool_category",
                "type": "string"
              },
              {
                "name": "tool_class",
                "type": "string"
              },
              {
                "name": "tool_in_scope",
                "type": "boolean"
              },
              {
                "name": "tool_name",
                "type": "string"
              },
              {
                "name": "tool_output",
                "type": "string"
              },
              {
                "name": "tool_risk",
                "type": "string"
              },
              {
                "name": "trace_id",
                "type": "string"
              },
              {
                "name": "url",
                "type": "string"
              }
            ]
          }
        },
        "destinations": {
          "logAnalytics": [
            {
              "workspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]",
              "name": "sentinelWorkspace"
            }
          ]
        },
        "dataFlows": [
          {
            "streams": [
              "Custom-AIAgentToolCallsRaw"
            ],
            "destinations": [
              "sentinelWorkspace"
            ],
            "transformKql": "source | project TimeGenerated = todatetime(timestamp), ActingAboveUserPrivilege = acting_above_user_privilege, ActorIsAdmin = actor_is_admin, AgentId = agent_id, AttachmentCount = attachment_count, ChangeOrigin = change_origin, ChangeTarget = change_target, CloudApi = cloud_api, ConfigKey = config_key, ContextHasUntrustedContent = context_has_untrusted_content, CostUsd = cost_usd, DestinationAllowlisted = destination_allowlisted, DestinationDomain = destination_domain, EventType = event_type, FilePath = file_path, HostId = host_id, HumanApproved = human_approved, InitiatedByUser = initiated_by_user, InputOrigin = input_origin, InputSpanIds = input_span_ids, InterArrivalS = inter_arrival_s, IsExternalEgress = is_external_egress, IsSecretRead = is_secret_read, Operation = operation, PageTrust = page_trust, ParentSpanId = parent_span_id, PrincipalId = principal_id, RecipientExternal = recipient_external, RecordsReturned = records_returned, RequestBytes = request_bytes, SessionId = session_id, SourceTrust = source_trust, SpanId = span_id, TargetCategory = target_category, ToolArgs = tool_args, ToolCategory = tool_category, ToolClass = tool_class, ToolInScope = tool_in_scope, ToolName = tool_name, ToolOutput = tool_output, ToolRisk = tool_risk, TraceId = trace_id, Url = url",
