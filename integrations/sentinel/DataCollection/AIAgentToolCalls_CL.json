                "type": "string"
              },
              {
                "name": "context_has_untrusted_content",
                "type": "boolean"
              },
              {
                "name": "cost_usd",
                "type": "real"
              },
              {
                "name": "destination_allowlisted",
                "type": "boolean"
              },
              {
                "name": "destination_domain",
                "type": "string"
              },
              {
                "name": "event_type",
                "type": "string"
              },
              {
                "name": "file_path",
                "type": "string"
              },
              {
                "name": "host_id",
                "type": "string"
              },
              {
                "name": "human_approved",
                "type": "boolean"
              },
              {
                "name": "initiated_by_user",
                "type": "boolean"
              },
              {
                "name": "input_origin",
                "type": "string"
