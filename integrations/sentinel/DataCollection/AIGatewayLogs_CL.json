              "Custom-AIGatewayLogsRaw"
            ],
            "destinations": [
              "sentinelWorkspace"
            ],
            "transformKql": "source | project TimeGenerated = todatetime(timestamp), ApiKeyId = api_key_id, ApiOperation = api_operation, Channel = channel, CitedUnretrievedSources = cited_unretrieved_sources, ClientApp = client_app, ClientAsn = client_asn, ClientHost = client_host, ClientIp = client_ip, Completion = completion, CompletionLinkDomains = completion_link_domains, CompletionLinkReputation = completion_link_reputation, ConfusableCharRatio = confusable_char_ratio, ContextUtilization = context_utilization, CostUsd = cost_usd, GuardrailVerdict = guardrail_verdict, HarmScore = harm_score, InputTokens = input_tokens, InterArrivalS = inter_arrival_s, InvisibleCharCount = invisible_char_count, JailbreakCorpusMatch = jailbreak_corpus_match, LatencyMs = latency_ms, LogprobsRequested = logprobs_requested, MemorizationScore = memorization_score, ModelId = model_id, ModelTier = model_tier, ModerationVerdict = moderation_verdict, NonexistentPackagesInCompletion = nonexistent_packages_in_completion, OutputTokens = output_tokens, PrincipalId = principal_id, Prompt = prompt, PromptDialogueTurns = prompt_dialogue_turns, PromptHash = prompt_hash, ReasoningTokens = reasoning_tokens, Refused = refused, RequestParamKeys = request_param_keys, ResponseHasCitations = response_has_citations, SessionId = session_id, SuffixPerplexity = suffix_perplexity, SuffixTokenCount = suffix_token_count, TotalTokens = total_tokens, UserAgent = user_agent, UserContent = user_content, WorkloadRegistered = workload_registered",
