{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "ATLAS Behavior Map: AIIdentityEvents_CL custom table and the data collection rule that ingests normalized 'identity' events through the Logs Ingestion API."
  },
  "parameters": {
    "workspaceName": {
      "type": "string",
      "metadata": {
        "description": "Log Analytics workspace of Microsoft Sentinel (same resource group)."
      }
    },
    "dataCollectionEndpointName": {
      "type": "string",
      "defaultValue": "abm-ingestion",
      "metadata": {
        "description": "Data collection endpoint shared by all ABM sources; created if missing."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Region of the workspace."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces/tables",
      "apiVersion": "2025-07-01",
      "name": "[format('{0}/{1}', parameters('workspaceName'), 'AIIdentityEvents_CL')]",
      "properties": {
        "plan": "Analytics",
        "schema": {
          "name": "AIIdentityEvents_CL",
          "columns": [
            {
              "name": "TimeGenerated",
              "type": "dateTime"
            },
            {
              "name": "AccountId",
              "type": "string"
            },
            {
              "name": "Asn",
              "type": "string"
            },
            {
              "name": "AuthMethod",
              "type": "string"
            },
            {
              "name": "ClientApp",
              "type": "string"
            },
            {
              "name": "ClientAsn",
              "type": "long"
            },
            {
              "name": "DeviceFingerprint",
              "type": "string"
            },
            {
              "name": "DeviceId",
              "type": "string"
            },
            {
              "name": "EventType",
              "type": "string"
            },
            {
              "name": "Ip",
              "type": "string"
            },
            {
              "name": "PrincipalId",
              "type": "string"
            },
            {
              "name": "SignInAsnSeenBefore",
              "type": "boolean"
            },
            {
              "name": "TokenId",
              "type": "string"
            },
            {
              "name": "TokenType",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Insights/dataCollectionEndpoints",
      "apiVersion": "2023-03-11",
      "name": "[parameters('dataCollectionEndpointName')]",
      "location": "[parameters('location')]",
      "properties": {
        "networkAcls": {
          "publicNetworkAccess": "Enabled"
        }
      }
    },
    {
      "type": "Microsoft.Insights/dataCollectionRules",
      "apiVersion": "2023-03-11",
      "name": "abm-identity",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces/tables', parameters('workspaceName'), 'AIIdentityEvents_CL')]",
        "[resourceId('Microsoft.Insights/dataCollectionEndpoints', parameters('dataCollectionEndpointName'))]"
      ],
      "properties": {
        "dataCollectionEndpointId": "[resourceId('Microsoft.Insights/dataCollectionEndpoints', parameters('dataCollectionEndpointName'))]",
        "streamDeclarations": {
          "Custom-AIIdentityEventsRaw": {
            "columns": [
              {
                "name": "account_id",
                "type": "string"
              },
              {
                "name": "asn",
                "type": "string"
              },
              {
                "name": "auth_method",
                "type": "string"
              },
              {
                "name": "client_app",
                "type": "string"
              },
              {
                "name": "client_asn",
                "type": "long"
              },
              {
                "name": "device_fingerprint",
                "type": "string"
              },
              {
                "name": "device_id",
                "type": "string"
              },
              {
                "name": "event_type",
                "type": "string"
              },
              {
                "name": "ip",
                "type": "string"
              },
              {
                "name": "principal_id",
                "type": "string"
              },
              {
                "name": "sign_in_asn_seen_before",
                "type": "boolean"
              },
              {
                "name": "timestamp",
                "type": "datetime"
              },
              {
                "name": "token_id",
                "type": "string"
              },
              {
                "name": "token_type",
                "type": "string"
              }
            ]
          }
        },
        "destinations": {
          "logAnalytics": [
            {
              "workspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]",
              "name": "sentinelWorkspace"
            }
          ]
        },
        "dataFlows": [
          {
            "streams": [
              "Custom-AIIdentityEventsRaw"
            ],
            "destinations": [
              "sentinelWorkspace"
            ],
            "transformKql": "source | project TimeGenerated = todatetime(timestamp), AccountId = account_id, Asn = asn, AuthMethod = auth_method, ClientApp = client_app, ClientAsn = client_asn, DeviceFingerprint = device_fingerprint, DeviceId = device_id, EventType = event_type, Ip = ip, PrincipalId = principal_id, SignInAsnSeenBefore = sign_in_asn_seen_before, TokenId = token_id, TokenType = token_type",
            "outputStream": "Custom-AIIdentityEvents_CL"
          }
        ]
      }
    }
  ],
  "outputs": {
    "logsIngestionEndpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Insights/dataCollectionEndpoints', parameters('dataCollectionEndpointName')), '2023-03-11').logsIngestion.endpoint]"
    },
    "dataCollectionRuleImmutableId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Insights/dataCollectionRules', 'abm-identity'), '2023-03-11').immutableId]"
    },
    "streamName": {
      "type": "string",
      "value": "Custom-AIIdentityEventsRaw"
    }
  }
}
