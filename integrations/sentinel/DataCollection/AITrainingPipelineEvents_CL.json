{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "ATLAS Behavior Map: AITrainingPipelineEvents_CL custom table and the data collection rule that ingests normalized 'training_pipeline' events through the Logs Ingestion API."
  },
  "parameters": {
    "workspaceName": {
      "type": "string",
      "metadata": {
        "description": "Log Analytics workspace of Microsoft Sentinel (same resource group)."
      }
    },
    "dataCollectionEndpointName": {
      "type": "string",
      "defaultValue": "abm-ingestion",
      "metadata": {
        "description": "Data collection endpoint shared by all ABM sources; created if missing."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Region of the workspace."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces/tables",
      "apiVersion": "2025-07-01",
      "name": "[format('{0}/{1}', parameters('workspaceName'), 'AITrainingPipelineEvents_CL')]",
      "properties": {
        "plan": "Analytics",
        "schema": {
          "name": "AITrainingPipelineEvents_CL",
          "columns": [
            {
              "name": "TimeGenerated",
              "type": "dateTime"
            },
            {
              "name": "BatchId",
              "type": "string"
            },
            {
              "name": "BudgetApproved",
              "type": "boolean"
            },
            {
              "name": "ChecksumMatch",
              "type": "boolean"
            },
            {
              "name": "ContributorId",
              "type": "string"
            },
            {
              "name": "ContributorType",
              "type": "string"
            },
            {
              "name": "DatasetId",
              "type": "string"
            },
            {
              "name": "DatasetProvenanceVerified",
              "type": "boolean"
            },
            {
              "name": "DatasetSensitivity",
              "type": "string"
            },
            {
              "name": "DistributionShiftPsi",
              "type": "real"
            },
            {
              "name": "EventType",
              "type": "string"
            },
            {
              "name": "JobId",
              "type": "string"
            },
            {
              "name": "LabelDisagreementRate",
              "type": "real"
            },
            {
              "name": "PipelineId",
              "type": "string"
            },
            {
              "name": "PrincipalId",
              "type": "string"
            },
            {
              "name": "PrincipalInDatasetAcl",
              "type": "boolean"
            },
            {
              "name": "ProvenanceSigned",
              "type": "boolean"
            },
            {
              "name": "RecordCount",
              "type": "long"
            },
            {
              "name": "RequestedGpuHours",
              "type": "long"
            },
            {
              "name": "SourceExternal",
              "type": "boolean"
            },
            {
              "name": "TargetEnvironment",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Insights/dataCollectionEndpoints",
      "apiVersion": "2023-03-11",
      "name": "[parameters('dataCollectionEndpointName')]",
      "location": "[parameters('location')]",
      "properties": {
        "networkAcls": {
          "publicNetworkAccess": "Enabled"
        }
      }
    },
    {
      "type": "Microsoft.Insights/dataCollectionRules",
      "apiVersion": "2023-03-11",
      "name": "abm-training-pipeline",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces/tables', parameters('workspaceName'), 'AITrainingPipelineEvents_CL')]",
        "[resourceId('Microsoft.Insights/dataCollectionEndpoints', parameters('dataCollectionEndpointName'))]"
      ],
      "properties": {
        "dataCollectionEndpointId": "[resourceId('Microsoft.Insights/dataCollectionEndpoints', parameters('dataCollectionEndpointName'))]",
        "streamDeclarations": {
          "Custom-AITrainingPipelineEventsRaw": {
            "columns": [
              {
                "name": "batch_id",
                "type": "string"
              },
              {
                "name": "budget_approved",
                "type": "boolean"
              },
              {
                "name": "checksum_match",
                "type": "boolean"
              },
              {
                "name": "contributor_id",
                "type": "string"
              },
              {
                "name": "contributor_type",
                "type": "string"
              },
              {
                "name": "dataset_id",
                "type": "string"
              },
              {
                "name": "dataset_provenance_verified",
                "type": "boolean"
              },
              {
                "name": "dataset_sensitivity",
                "type": "string"
              },
              {
                "name": "distribution_shift_psi",
                "type": "real"
              },
              {
                "name": "event_type",
                "type": "string"
              },
              {
                "name": "job_id",
                "type": "string"
              },
              {
                "name": "label_disagreement_rate",
                "type": "real"
              },
              {
                "name": "pipeline_id",
                "type": "string"
              },
              {
                "name": "principal_id",
                "type": "string"
              },
              {
                "name": "principal_in_dataset_acl",
                "type": "boolean"
              },
              {
                "name": "provenance_signed",
                "type": "boolean"
              },
              {
                "name": "record_count",
                "type": "long"
              },
              {
                "name": "requested_gpu_hours",
                "type": "long"
              },
              {
                "name": "source_external",
                "type": "boolean"
              },
              {
                "name": "target_environment",
                "type": "string"
              },
              {
                "name": "timestamp",
                "type": "datetime"
              }
            ]
          }
        },
        "destinations": {
          "logAnalytics": [
            {
              "workspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]",
              "name": "sentinelWorkspace"
            }
          ]
        },
        "dataFlows": [
          {
            "streams": [
              "Custom-AITrainingPipelineEventsRaw"
            ],
            "destinations": [
              "sentinelWorkspace"
            ],
            "transformKql": "source | project TimeGenerated = todatetime(timestamp), BatchId = batch_id, BudgetApproved = budget_approved, ChecksumMatch = checksum_match, ContributorId = contributor_id, ContributorType = contributor_type, DatasetId = dataset_id, DatasetProvenanceVerified = dataset_provenance_verified, DatasetSensitivity = dataset_sensitivity, DistributionShiftPsi = distribution_shift_psi, EventType = event_type, JobId = job_id, LabelDisagreementRate = label_disagreement_rate, PipelineId = pipeline_id, PrincipalId = principal_id, PrincipalInDatasetAcl = principal_in_dataset_acl, ProvenanceSigned = provenance_signed, RecordCount = record_count, RequestedGpuHours = requested_gpu_hours, SourceExternal = source_external, TargetEnvironment = target_environment",
            "outputStream": "Custom-AITrainingPipelineEvents_CL"
          }
        ]
      }
    }
  ],
  "outputs": {
    "logsIngestionEndpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Insights/dataCollectionEndpoints', parameters('dataCollectionEndpointName')), '2023-03-11').logsIngestion.endpoint]"
    },
    "dataCollectionRuleImmutableId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Insights/dataCollectionRules', 'abm-training-pipeline'), '2023-03-11').immutableId]"
    },
    "streamName": {
      "type": "string",
      "value": "Custom-AITrainingPipelineEventsRaw"
    }
  }
}
