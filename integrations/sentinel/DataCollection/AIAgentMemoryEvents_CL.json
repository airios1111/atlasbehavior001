{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "ATLAS Behavior Map: AIAgentMemoryEvents_CL custom table and the data collection rule that ingests normalized 'agent_memory' events through the Logs Ingestion API."
  },
  "parameters": {
    "workspaceName": {
      "type": "string",
      "metadata": {
        "description": "Log Analytics workspace of Microsoft Sentinel (same resource group)."
      }
    },
    "dataCollectionEndpointName": {
      "type": "string",
      "defaultValue": "abm-ingestion",
      "metadata": {
        "description": "Data collection endpoint shared by all ABM sources; created if missing."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Region of the workspace."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces/tables",
      "apiVersion": "2025-07-01",
      "name": "[format('{0}/{1}', parameters('workspaceName'), 'AIAgentMemoryEvents_CL')]",
      "properties": {
        "plan": "Analytics",
        "schema": {
          "name": "AIAgentMemoryEvents_CL",
          "columns": [
            {
              "name": "TimeGenerated",
              "type": "dateTime"
            },
            {
              "name": "ActorIsConversationOwner",
              "type": "boolean"
            },
            {
              "name": "AgentId",
              "type": "string"
            },
            {
              "name": "ConversationId",
              "type": "string"
            },
            {
              "name": "MemoryText",
              "type": "string"
            },
            {
              "name": "Operation",
              "type": "string"
            },
            {
              "name": "PrincipalId",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Insights/dataCollectionEndpoints",
      "apiVersion": "2023-03-11",
      "name": "[parameters('dataCollectionEndpointName')]",
      "location": "[parameters('location')]",
      "properties": {
        "networkAcls": {
          "publicNetworkAccess": "Enabled"
        }
      }
    },
    {
      "type": "Microsoft.Insights/dataCollectionRules",
      "apiVersion": "2023-03-11",
      "name": "abm-agent-memory",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces/tables', parameters('workspaceName'), 'AIAgentMemoryEvents_CL')]",
        "[resourceId('Microsoft.Insights/dataCollectionEndpoints', parameters('dataCollectionEndpointName'))]"
      ],
      "properties": {
        "dataCollectionEndpointId": "[resourceId('Microsoft.Insights/dataCollectionEndpoints', parameters('dataCollectionEndpointName'))]",
        "streamDeclarations": {
          "Custom-AIAgentMemoryEventsRaw": {
            "columns": [
              {
                "name": "actor_is_conversation_owner",
                "type": "boolean"
              },
              {
                "name": "agent_id",
                "type": "string"
              },
              {
                "name": "conversation_id",
                "type": "string"
              },
              {
                "name": "memory_text",
                "type": "string"
              },
              {
                "name": "operation",
                "type": "string"
              },
              {
                "name": "principal_id",
                "type": "string"
              },
              {
                "name": "timestamp",
                "type": "datetime"
              }
            ]
          }
        },
        "destinations": {
          "logAnalytics": [
            {
              "workspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]",
              "name": "sentinelWorkspace"
            }
          ]
        },
        "dataFlows": [
          {
            "streams": [
              "Custom-AIAgentMemoryEventsRaw"
            ],
            "destinations": [
              "sentinelWorkspace"
            ],
            "transformKql": "source | project TimeGenerated = todatetime(timestamp), ActorIsConversationOwner = actor_is_conversation_owner, AgentId = agent_id, ConversationId = conversation_id, MemoryText = memory_text, Operation = operation, PrincipalId = principal_id",
            "outputStream": "Custom-AIAgentMemoryEvents_CL"
          }
        ]
      }
    }
  ],
  "outputs": {
    "logsIngestionEndpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Insights/dataCollectionEndpoints', parameters('dataCollectionEndpointName')), '2023-03-11').logsIngestion.endpoint]"
    },
    "dataCollectionRuleImmutableId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Insights/dataCollectionRules', 'abm-agent-memory'), '2023-03-11').immutableId]"
    },
    "streamName": {
      "type": "string",
      "value": "Custom-AIAgentMemoryEventsRaw"
    }
  }
}
